# Copy this file to `.env` (never commit `.env`).

# PostgreSQL connection string used by the server only (never exposed to the browser).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Required together with RESEND_API_KEY and EMAIL_FROM for reset emails.
# Use your trusted HTTPS site URL (no path/query). Never derive reset URLs from
# the request Host header; that can expose a user's reset token.
# APP_URL=https://pos.example.com

# Optional — configure ALL THREE values to enable password reset emails through
# Resend (https://resend.com). Verify your sending domain with Resend first.
# When unconfigured, no email is sent, no reset token is created, and no reset
# link is printed to server logs or exposed in a public API response.
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM="Charlotte Esthy <no-reply@your-domain.com>"
