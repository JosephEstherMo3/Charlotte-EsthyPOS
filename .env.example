# Copy this file to `.env` (never commit `.env`).

# PostgreSQL connection string used by the server only (never exposed to the browser).
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Application URL (used for building verification and reset links).
APP_URL=http://localhost:3000

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION
# Configure EmailJS (https://www.emailjs.com/) or Resend (https://resend.com)
# ==============================================================================

# Option 1: EmailJS (Recommended for easy setup)
# Find these in your EmailJS Dashboard:
# 1. Service ID: Email Services -> Service ID (e.g., service_xxxxxxx)
# 2. Template ID: Email Templates -> Template ID (e.g., template_xxxxxxx)
# 3. Public Key: Account -> API Keys -> Public Key
# 4. Private Key: Account -> API Keys -> Private Key (optional, if Strict Mode is enabled)
# EMAILJS_SERVICE_ID=service_xxxxxxx
# EMAILJS_TEMPLATE_ID=template_xxxxxxx
# EMAILJS_PUBLIC_KEY=xxxxxxx_xxxxxxx
# EMAILJS_PRIVATE_KEY=xxxxxxx_xxxxxxx

# Supabase configuration – replace placeholders with your actual values
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
# Optional: Direct DB connection (if not using pooler)
DB_PROJECT_REF=<PROJECT_REF>
DB_PASSWORD=<PASSWORD>

# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM="Charlotte Esthy <no-reply@your-domain.com>"
# .env.local
